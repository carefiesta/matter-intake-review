# Extraction provider. "fixture" is the default and needs no key.
# Set this to remote only if you want a language-model HTTP endpoint.
LLM_PROVIDER=fixture

# Used only when LLM_PROVIDER=remote. Do not commit real keys.
# LLM_BASE_URL=https://example.test/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional. The local demo uses a development session secret if this is unset.
# INTAKE_SESSION_SECRET=
# INTAKE_DB=data/intake.db
# PORT=8000
